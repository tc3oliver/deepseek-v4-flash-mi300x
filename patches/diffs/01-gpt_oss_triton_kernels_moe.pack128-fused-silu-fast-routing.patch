+def _fast_make_routing_data(topk_ids, topk_weights, num_local_experts):
+    n_rows, num_topk = topk_ids.shape
+    n_assignments = n_rows * num_topk
+    max_tiles = RaggedTensorMetadata.max_n_tiles(
+        num_local_experts, n_assignments
+    )
+    device = topk_ids.device
+    combine = torch.empty(n_assignments, dtype=torch.int32, device=device)
+    dispatch = torch.empty_like(combine)
+    gate = torch.empty(n_assignments, dtype=torch.bfloat16, device=device)
+    hist = torch.empty(num_local_experts, dtype=torch.int32, device=device)
+    slice_offs = torch.empty(num_local_experts + 1, dtype=torch.int32, device=device)
+    block_offs = torch.empty(
+        (5, num_local_experts + 1), dtype=torch.int32, device=device
+    )
+    block_schedule = torch.empty((5, max_tiles), dtype=torch.int32, device=device)
+    _fast_deepseek_routing[(1,)](
+        topk_ids,
+        topk_weights,
+        combine,
+        dispatch,
+        gate,
+        hist,
+        slice_offs,
+        block_offs,
+        block_schedule,
+        N=n_assignments,
+        E=num_local_experts,
+        SORT=triton.next_power_of_2(n_assignments),
+        MAX_TILES=max_tiles,
+        SCHED=triton.next_power_of_2(max_tiles),
+        # Top-k has no duplicate expert within a row, including padded rows.
+        MAX_BLOCKS_PER_EXPERT=triton.cdiv(n_rows, 16),
+        num_warps=4,
+    )
+    metadata = RaggedTensorMetadata(hist, slice_offs, block_offs, block_schedule)
+    routing_data = RoutingData(
+        gate, metadata.block_sizes, num_local_experts, num_topk, metadata
+    )
+    return (
+        routing_data,
+        GatherIndx(combine, dispatch),
+        ScatterIndx(dispatch, combine),
+    )
+
