+@triton.jit
+def _fast_deepseek_routing(
+    Ids,
+    Weights,
+    Combine,
+    Dispatch,
+    Gate,
+    Hist,
+    SliceOffs,
+    BlockOffs,
+    BlockSchedule,
+    N: tl.constexpr,
+    E: tl.constexpr,
+    SORT: tl.constexpr,
+    MAX_TILES: tl.constexpr,
+    SCHED: tl.constexpr,
+    MAX_BLOCKS_PER_EXPERT: tl.constexpr,
+):
+    offs = tl.arange(0, SORT)
+    mask = offs < N
+    expert = tl.load(Ids + offs, mask=mask, other=-1).to(tl.int32)
+    active = mask & (expert >= 0) & (expert < E)
+    sentinel: tl.constexpr = 0x7FFFFFFF
+    keys = tl.sort(tl.where(active, expert * SORT + offs, sentinel), 0)
+    sorted_active = keys != sentinel
+    sorted_idx = keys % SORT
+    tl.store(Combine + offs, tl.where(sorted_active, sorted_idx, -1), mask=mask)
+    vals = tl.load(Weights + sorted_idx, mask=sorted_active, other=-1.0)
+    tl.store(Gate + offs, tl.where(sorted_active, vals, -1.0), mask=mask)
+    tl.store(Dispatch + offs, -1, mask=mask)
+
+    experts = tl.arange(0, E)
+    tl.store(Hist + experts, 0)
+    schedule = tl.arange(0, SCHED)
+    for size_id in tl.static_range(0, 5):
+        tl.store(
+            BlockSchedule + size_id * MAX_TILES + schedule,
+            -1,
+            mask=schedule < MAX_TILES,
+        )
+    tl.debug_barrier()
+
+    tl.store(Dispatch + sorted_idx, offs, mask=sorted_active)
+    tl.atomic_add(Hist + expert, 1, mask=active)
+    tl.debug_barrier()
+
+    hist = tl.load(Hist + experts)
+    cumulative = tl.cumsum(hist, 0)
+    tl.store(SliceOffs + experts, cumulative - hist)
+    tl.store(SliceOffs + E, tl.sum(hist))
+    for size_id in tl.static_range(0, 5):
+        log2_block = 4 + size_id
+        nblocks = (hist + (1 << log2_block) - 1) >> log2_block
+        cumulative_blocks = tl.cumsum(nblocks, 0)
+        starts = cumulative_blocks - nblocks
+        block_offs = BlockOffs + size_id * (E + 1)
+        tl.store(block_offs + experts, starts)
+        tl.store(block_offs + E, tl.sum(nblocks))
+        for block in tl.static_range(0, MAX_BLOCKS_PER_EXPERT):
+            tl.store(
+                BlockSchedule + size_id * MAX_TILES + starts + block,
+                (block << 16) + experts,
+                mask=block < nblocks,
+            )
+
