+@triton.jit
+def _silu_mul(inp):
+    gate, up = tl.split(
+        tl.reshape(inp, (inp.shape[0], inp.shape[1] // 2, 2))
+    )
+    gate = gate.to(tl.float32)
+    up = up.to(tl.float32)
+    return gate / (1.0 + tl.exp(-gate)) * up
+
